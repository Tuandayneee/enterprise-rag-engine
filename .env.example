# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL with pgvector & Full-Text Search
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_enterprise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_enterprise

# Redis Cache & Sliding Window Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# LLM Serving (vLLM / Ollama OpenAI-compatible endpoint)
LLM_PROVIDER=mock  # Options: 'mock', 'ollama', 'vllm', 'openai'
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct  # or llama3.1:8b
OPENAI_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Embedding & Reranker Models
EMBEDDING_MODEL_NAME=BAAI/bge-m3  # or text-embedding-3-small
EMBEDDING_DIMENSION=1024
RERANKER_MODEL_NAME=BAAI/bge-reranker-large

# Ingestion & Chunking Parameters
CHUNK_SIMILARITY_THRESHOLD=0.75
FIXED_CHUNK_SIZE=512
FIXED_CHUNK_OVERLAP=50
SEMANTIC_MIN_CHUNK_SIZE=100
SEMANTIC_MAX_CHUNK_SIZE=800
RRF_K=60
RERANK_TOP_K=5
RERANK_CANDIDATE_POOL=20
